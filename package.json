{
  "name": "chess-pgn-reports",
  "version": "1.0.0",
  "description": "Turn a chess PGN into a printable opening theory table (ECO/MCO style).",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "node --test 'tests/**/*.test.mjs'",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "coverage": "node --test --experimental-test-coverage --test-coverage-exclude='tests/**' 'tests/**/*.test.mjs'",
    "knip": "knip"
  },
  "keywords": [
    "chess",
    "pgn",
    "opening",
    "theory-table",
    "eco"
  ],
  "author": "Davis Pies",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "chess.js": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.0",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "knip": "^6.32.2"
  }
}
